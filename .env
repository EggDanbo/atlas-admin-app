TARO_APP_USE_MOCK=true
TARO_APP_PASSWORD_LOGIN=true
TARO_APP_H5_BASENAME=app

# 独立文件预览服务地址（frontend-lib/file-viewer 项目）
# 留空=使用本应用内置预览页 /pages/mine/preview（仅开发模式有效，内置页不进生产包）
# /file-preview=同域名子路径部署（生产推荐，nginx 挂载，见 file-viewer 项目 README）
# http://preview.example.com=独立域名部署（文件服务需配 CORS）
# 注意：生产构建必须配置非空值，否则预览跳转 404
TARO_APP_FILE_PREVIEW_BASE=
